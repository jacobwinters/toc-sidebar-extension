{
	"manifest_version": 2,
	"name": "TOC sidebar",
	"version": "1.0",
	"icons": {
		"32": "icon.svg"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "toc-sidebar@jacobwinters.com",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"sidebar_action": {
		"default_title": "Table of Contents",
		"default_panel": "sidebar.xhtml",
		"default_icon": "icon.svg"
	},
	"browser_action": {
		"default_area": "navbar"
	},
	"background": {
		"scripts": ["background.js"]
	},
	"permissions": [
		"<all_urls>",
		"webNavigation"
	]
}
